// اختبار مجموع المربعات - كنز
// حلقة حسابية بسيطة لقياس أداء العمليات الأساسية

دالة رئيسية() -> صحيح {
    دع حد: صحيح = 100000000;
    دع متغير مجموع: صحيح = 0;
    دع متغير ع: صحيح = 1;
    
    طالما ع <= حد {
        مجموع = مجموع + ع * ع;
        ع = ع + 1;
    }
    
    اطبع("Sum of squares 1 to ");
    اطبع_صحيح(حد);
    اطبع(" = ");
    اطبع_صحيح(مجموع);
    اطبع("\n");
    أرجع 0;
}
