// اختبار فيبوناتشي - كنز
// حساب فيبوناتشي بالتكرار لقياس أداء استدعاء الدوال

دالة فيبوناتشي(ن: صحيح) -> صحيح {
    إذا ن <= 1 {
        أرجع ن;
    }
    أرجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2);
}

دالة رئيسية() -> صحيح {
    دع ق: صحيح = 40;
    دع ناتج: صحيح = فيبوناتشي(ق);
    اطبع("fibonacci(");
    اطبع_صحيح(ق);
    اطبع(") = ");
    اطبع_صحيح(ناتج);
    اطبع("\n");
    أرجع 0;
}
