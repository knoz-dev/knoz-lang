// اختبار حدسية كولاتز - كنز
// اختبار أداء التفرع والحلقات

دالة طول_كولاتز(متغير ي: صحيح) -> صحيح {
    دع متغير طول: صحيح = 1;
    طالما ي != 1 {
        إذا ي % 2 == 0 {
            ي = ي / 2;
        } وإلا {
            ي = 3 * ي + 1;
        }
        طول = طول + 1;
    }
    أرجع طول;
}

دالة رئيسية() -> صحيح {
    دع حد: صحيح = 1000000;
    دع متغير أطول: صحيح = 0;
    دع متغير البداية: صحيح = 0;
    دع متغير ع: صحيح = 1;
    
    طالما ع <= حد {
        دع طول: صحيح = طول_كولاتز(ع);
        إذا طول > أطول {
            أطول = طول;
            البداية = ع;
        }
        ع = ع + 1;
    }
    
    اطبع("Longest Collatz sequence up to ");
    اطبع_صحيح(حد);
    اطبع(": start=");
    اطبع_صحيح(البداية);
    اطبع(", length=");
    اطبع_صحيح(أطول);
    اطبع("\n");
    أرجع 0;
}
