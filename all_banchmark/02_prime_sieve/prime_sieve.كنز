// اختبار غربال الأعداد الأولية - كنز
// غربال إراتوستينس لقياس أداء الوصول للمصفوفات

دالة رئيسية() -> صحيح {
    دع حد: صحيح = 100000;
    دع متغير عداد: صحيح = 0;
    
    // حساب الأعداد الأولية بطريقة مباشرة (بدون مصفوفة)
    دع متغير ي: صحيح = 2;
    طالما ي <= حد {
        دع متغير أولي: منطقي = صح;
        دع متغير ق: صحيح = 2;
        طالما ق * ق <= ي {
            إذا ي % ق == 0 {
                أولي = خطأ;
                أوقف;
            }
            ق = ق + 1;
        }
        إذا أولي {
            عداد = عداد + 1;
        }
        ي = ي + 1;
    }
    
    اطبع("Primes up to ");
    اطبع_صحيح(حد);
    اطبع(": ");
    اطبع_صحيح(عداد);
    اطبع("\n");
    أرجع 0;
}
