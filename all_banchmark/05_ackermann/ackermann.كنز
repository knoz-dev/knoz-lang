// اختبار دالة أكرمان - كنز
// اختبار أداء التكرار العميق

دالة أكرمان(م: صحيح, ي: صحيح) -> صحيح {
    إذا م == 0 {
        أرجع ي + 1;
    }
    إذا ي == 0 {
        أرجع أكرمان(م - 1, 1);
    }
    أرجع أكرمان(م - 1, أكرمان(م, ي - 1));
}

دالة رئيسية() -> صحيح {
    دع م: صحيح = 3;
    دع ي: صحيح = 10;
    دع ناتج: صحيح = أكرمان(م, ي);
    اطبع("ackermann(");
    اطبع_صحيح(م);
    اطبع(", ");
    اطبع_صحيح(ي);
    اطبع(") = ");
    اطبع_صحيح(ناتج);
    اطبع("\n");
    أرجع 0;
}
