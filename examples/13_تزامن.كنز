// =============================================
// مثال 12: التزامن والأقفال
// =============================================

دالة رئيسية() -> صحيح {
    اطبع("=== التزامن والأقفال ===");
    
    // --- اختبار القفل (Mutex) ---
    اطبع("=== القفل ===");
    دع قفلي = قفل_جديد();
    
    قفل_أقفل(قفلي);
    اطبع("تم إغلاق القفل");
    
    قفل_افتح(قفلي);
    اطبع("تم فتح القفل");
    
    // اختبار محاولة القفل
    دع نجح = قفل_حاول(قفلي);
    إذا نجح {
        اطبع("نجحت محاولة القفل");
        قفل_افتح(قفلي);
    }
    
    قفل_حرر(قفلي);
    اطبع("تم تحرير القفل");
    
    // --- مجموعة الانتظار ---
    اطبع("=== مجموعة الانتظار ===");
    دع انتظار = مجموعة_انتظار_جديد();
    
    مجموعة_انتظار_أضف(انتظار, 2);
    اطبع("أضفنا 2 للانتظار");
    
    مجموعة_انتظار_تم(انتظار);
    اطبع("تم 1");
    
    مجموعة_انتظار_تم(انتظار);
    اطبع("تم 2");
    
    مجموعة_انتظار_انتظر(انتظار);
    اطبع("انتهى الانتظار");
    
    مجموعة_انتظار_حرر(انتظار);
    
    // --- العمليات الذرية ---
    اطبع("=== العمليات الذرية ===");
    
    دع متغير عدد = 0;
    
    دع ناتج = ذري_أضف(&عدد, 10);
    اطبع("بعد إضافة 10 ذرياً: ");
    اطبع_صحيح(ناتج);
    
    دع ناتج2 = ذري_أضف(&عدد, 5);
    اطبع("بعد إضافة 5 ذرياً: ");
    اطبع_صحيح(ناتج2);
    
    اطبع("=== انتهى مثال التزامن ===");
    
    أرجع 0;
}
