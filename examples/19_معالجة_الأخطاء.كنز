// =============================================
// مثال 19: معالجة الأخطاء (Error Handling)
// =============================================
// جرب/التقط/أخيرا للتحكم في الأخطاء
// ألق لرمي الأخطاء

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== معالجة الأخطاء ===");
    
    // === جرب/أخيرا ===
    اطبع("=== جرب/أخيرا ===");
    
    جرب {
        اطبع("داخل كتلة جرب");
        اطبع("تنفيذ طبيعي");
    } أخيرا {
        اطبع("تنفيذ أخيرا دائماً");
    }
    
    // === جرب/التقط ===
    اطبع("=== جرب/التقط ===");
    
    جرب {
        اطبع("قبل رمي الخطأ");
        ألق "خطأ تجريبي!"
        اطبع("لن يُطبع هذا");
    } التقط خ {
        اطبع("تم التقاط الخطأ!");
    }
    
    // === جرب/التقط/أخيرا ===
    اطبع("=== جرب/التقط/أخيرا ===");
    
    جرب {
        اطبع("محاولة عملية خطرة");
        ألق "فشل العملية"
    } التقط خ_العملية {
        اطبع("معالجة الخطأ");
    } أخيرا {
        اطبع("تنظيف الموارد");
    }
    
    // === جرب متداخل ===
    اطبع("=== جرب متداخل ===");
    
    جرب {
        اطبع("الكتلة الخارجية");
        
        جرب {
            اطبع("الكتلة الداخلية");
            ألق "خطأ داخلي"
        } التقط خ_داخلي {
            اطبع("معالجة الخطأ الداخلي");
        }
        
        اطبع("استمرار الكتلة الخارجية");
    } التقط خ_خارجي {
        اطبع("هذا لن يُنفذ");
    } أخيرا {
        اطبع("تنظيف الكتلة الخارجية");
    }
    
    // === بدون خطأ ===
    اطبع("=== بدون خطأ ===");
    
    جرب {
        اطبع("عملية ناجحة");
        دع س: ص64 = 10;
        دع ص: ص64 = 20;
        اطبع("الناتج:");
        اطبع_صحيح(س + ص);
    } التقط خ {
        اطبع("لن يُنفذ - لا يوجد خطأ");
    } أخيرا {
        اطبع("تم بنجاح");
    }
    
    اطبع("=== انتهى مثال معالجة الأخطاء ===");
    
    أرجع 0;
}
