// =============================================

دالة رئيسية() {
    اطبع("=== المتغيرات والأنواع ===");
    
    // --- المتغيرات الثابتة (غير قابلة للتغيير) ---
    دع عدد = 42;
    دع قيمة_عشرية = 3.14159;
    دع رسالة = "مرحباً بالعربية!";
    دع علم = صح;
    
    اطبع("عدد صحيح: ");
    اطبع_صحيح(عدد);
    
    اطبع("قيمة عشرية: ");
    اطبع_عشري(قيمة_عشرية);
    
    اطبع("رسالة: ");
    اطبع(رسالة);
    
    اطبع("علم منطقي: ");
    اطبع_منطقي(علم);
    
    // --- المتغيرات المتغيرة ---
    دع متغير عداد = 0;
    اطبع("العداد قبل: ");
    اطبع_صحيح(عداد);
    
    عداد = عداد + 10;
    اطبع("العداد بعد: ");
    اطبع_صحيح(عداد);
    
    // --- الحرف العربي ---
    دع الحرف_العربي = 'ع';
    اطبع("حرف: ");
    اطبع_صحيح(حرف_لرقم(الحرف_العربي));
    
    اطبع("=== انتهى مثال المتغيرات ===");
}
