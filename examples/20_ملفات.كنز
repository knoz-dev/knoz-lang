// =============================================
// مثال 20: التعامل مع الملفات (File I/O)
// =============================================
// الدوال: افتح_ملف، أغلق_ملف، اكتب_نص_ملف، احذف_ملف

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== التعامل مع الملفات ===");
    
    // === كتابة ملف جديد ===
    اطبع("=== كتابة ملف جديد ===");
    
    دع ملف = افتح_ملف("/tmp/test_knoz.txt", "w");
    إذا ملف != 0 {
        اطبع("تم فتح الملف للكتابة");
        
        اكتب_نص_ملف("السطر الأول\n", ملف);
        اكتب_نص_ملف("السطر الثاني\n", ملف);
        اكتب_نص_ملف("السطر الثالث\n", ملف);
        
        أغلق_ملف(ملف);
        اطبع("تم كتابة وإغلاق الملف");
    } وإلا {
        اطبع("فشل فتح الملف للكتابة");
    }
    
    // === إضافة للملف ===
    اطبع("=== إضافة للملف ===");
    
    دع ملف_اضافة = افتح_ملف("/tmp/test_knoz.txt", "a");
    إذا ملف_اضافة != 0 {
        اطبع("تم فتح الملف للإضافة");
        
        اكتب_نص_ملف("سطر إضافي 1\n", ملف_اضافة);
        اكتب_نص_ملف("سطر إضافي 2\n", ملف_اضافة);
        
        أغلق_ملف(ملف_اضافة);
        اطبع("تم إضافة الأسطر وإغلاق الملف");
    }
    
    // === قراءة الملف ===
    اطبع("=== قراءة الملف ===");
    
    دع ملف_قراءة = افتح_ملف("/tmp/test_knoz.txt", "r");
    إذا ملف_قراءة != 0 {
        اطبع("تم فتح الملف للقراءة");
        
        // التحقق من موقع الملف
        دع موقع = موقع_ملف(ملف_قراءة);
        اطبع("موقع البداية:");
        اطبع_صحيح(موقع);
        
        أغلق_ملف(ملف_قراءة);
        اطبع("تم إغلاق الملف");
    }
    
    // === حذف الملف ===
    اطبع("=== حذف الملف ===");
    
    احذف_ملف("/tmp/test_knoz.txt");
    اطبع("تم حذف الملف");
    
    // === التحقق من الحذف ===
    اطبع("=== التحقق من الحذف ===");
    
    دع ملف_محذوف = افتح_ملف("/tmp/test_knoz.txt", "r");
    إذا ملف_محذوف == 0 {
        اطبع("الملف لم يعد موجوداً - الحذف نجح");
    } وإلا {
        اطبع("الملف لا يزال موجوداً");
        أغلق_ملف(ملف_محذوف);
        اطبع("تم إغلاق الملف");
    }
    
    اطبع("=== انتهى مثال الملفات ===");
    
    أرجع 0;
}
