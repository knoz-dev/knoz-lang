// =============================================
// مثال 10: الدوال المدمجة
// =============================================

دالة رئيسية() {
    اطبع("=== الدوال المدمجة ===");
    
    // --- دوال الطباعة ---
    اطبع("هذا سطر أول");
    اطبع("هذا سطر ثاني");
    طباعة("طباعة مع قيمة: {}", 42);
    
    // --- دوال الرياضيات ---
    اطبع("=== دوال الرياضيات ===");
    
    دع قيم_سالبة = 0.0 - 15.7;
    اطبع("القيمة المطلقة لـ -15.7: ");
    اطبع_عشري(مطلق_عشري(قيم_سالبة));
    
    اطبع("2^10 = ");
    اطبع_عشري(قوة_ع(2.0, 10.0));
    
    اطبع("جذر 144: ");
    اطبع_عشري(جذر_تربيعي(144.0));
    
    // --- دوال المثلثات ---
    اطبع("=== دوال المثلثات ===");
    اطبع("جيب(0): ");
    اطبع_عشري(جيب(0.0));
    
    اطبع("جتا(0): ");
    اطبع_عشري(جتا(0.0));
    
    // --- دوال التقريب (تُرجع صحيح) ---
    اطبع("=== دوال التقريب ===");
    
    اطبع("تقريب 3.7: ");
    اطبع_صحيح(تقريب(3.7));
    
    اطبع("أرضية 3.7: ");
    اطبع_صحيح(أرضية(3.7));
    
    اطبع("سقف 3.7: ");
    اطبع_صحيح(سقف(3.7));
    
    // --- دوال التحويل ---
    اطبع("=== دوال التحويل ===");
    
    دع عدد_صحيح = 123;
    دع كنص = صحيح_لنص(عدد_صحيح);
    اطبع("تحويل 123 إلى نص: ");
    اطبع(كنص);
    
    دع صحيح_عشري = صحيح_لعشري(100);
    اطبع("تحويل 100 إلى عشري: ");
    اطبع_عشري(صحيح_عشري);
    
    دع عشري_صحيح = عشري_لصحيح(3.9);
    اطبع("تحويل 3.9 إلى صحيح: ");
    اطبع_صحيح(عشري_صحيح);
    
    // --- دالة الوقت ---
    اطبع("=== دالة الوقت ===");
    اطبع("الوقت الحالي (ثواني منذ 1970): ");
    اطبع_صحيح(وقت());
    
    // --- دالة طول النص ---
    اطبع("=== طول النص ===");
    اطبع("طول 'مرحبا عالم': ");
    اطبع_صحيح(طول("مرحبا عالم"));
    
    اطبع("=== انتهى مثال الدوال المدمجة ===");
}
