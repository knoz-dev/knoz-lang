// Lambda Expressions and Closures
// =============================================

// دالة رئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== تعبيرات لامدا ===");
    
    // --- لامدا بسيطة ---
    اطبع("--- لامدا بسيطة ---");
    
    // تعريف لامدا للجمع
    دع جمع = |س: صحيح, ص: صحيح| -> صحيح { أرجع س + ص; };
    
    دع ناتج_جمع = جمع(10, 20);
    اطبع("10 + 20 = ");
    اطبع_صحيح(ناتج_جمع);
    
    // تعريف لامدا للضرب
    دع ضرب = |س: صحيح, ص: صحيح| -> صحيح { أرجع س * ص; };
    
    دع ناتج_ضرب = ضرب(5, 6);
    اطبع("5 * 6 = ");
    اطبع_صحيح(ناتج_ضرب);
    
    // --- لامدا للقسمة ---
    اطبع("--- لامدا للقسمة ---");
    
    دع قسم = |س: صحيح, ص: صحيح| -> صحيح { أرجع س / ص; };
    
    دع ناتج_قسم = قسم(100, 4);
    اطبع("100 / 4 = ");
    اطبع_صحيح(ناتج_قسم);
    
    // --- لامدا للباقي ---
    اطبع("--- لامدا للباقي ---");
    
    دع باقي = |س: صحيح, ص: صحيح| -> صحيح { أرجع س % ص; };
    
    دع ناتج_باقي = باقي(17, 5);
    اطبع("17 % 5 = ");
    اطبع_صحيح(ناتج_باقي);

    // --- لامدا للمقارنة ---
    اطبع("--- لامدا للمقارنة ---");
    
    دع الأقصى = |س: صحيح, ص: صحيح| -> صحيح {
        إذا س > ص {
            أرجع س;
        }
        أرجع ص;
    };
    
    اطبع("الأقصى بين 25 و 18: ");
    اطبع_صحيح(الأقصى(25, 18));
    
    دع الأدنى = |س: صحيح, ص: صحيح| -> صحيح {
        إذا س < ص {
            أرجع س;
        }
        أرجع ص;
    };
    
    اطبع("الأدنى بين 25 و 18: ");
    اطبع_صحيح(الأدنى(25, 18));
    
    // --- لامدا للتربيع ---
    اطبع("--- لامدا للتربيع ---");
    
    دع مربع = |س: صحيح| -> صحيح { أرجع س * س; };
    
    اطبع("مربع 7: ");
    اطبع_صحيح(مربع(7));
    
    اطبع("مربع 12: ");
    اطبع_صحيح(مربع(12));
    
    // --- لامدا للمكعب ---
    دع مكعب = |س: صحيح| -> صحيح { أرجع س * س * س; };
    
    اطبع("مكعب 3: ");
    اطبع_صحيح(مكعب(3));
    
    // --- لامدا مع حسابات مركبة ---
    اطبع("--- لامدا مركبة ---");
    
    دع مساحة_مستطيل = |طول: صحيح, عرض: صحيح| -> صحيح { أرجع طول * عرض; };
    
    اطبع("مساحة مستطيل (5 × 8): ");
    اطبع_صحيح(مساحة_مستطيل(5, 8));
    
    // استخدام نتيجة لامدا في لامدا أخرى
    دع ضعف = |س: صحيح| -> صحيح { أرجع س * 2; };
    
    اطبع("ضعف مربع 4: ");
    اطبع_صحيح(ضعف(مربع(4)));

    اطبع("=== انتهى مثال اللامدا ===");
    أرجع 0;
}
