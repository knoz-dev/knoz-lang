// =============================================
// مثال 2: العمليات الحسابية والمنطقية
// =============================================

دالة رئيسية() {
    اطبع("=== العمليات الحسابية ===");
    
    دع أ = 20;
    دع ب = 7;
    
    // العمليات الحسابية الأساسية
    اطبع("الجمع 20+7: ");
    اطبع_صحيح(أ + ب);
    
    اطبع("الطرح 20-7: ");
    اطبع_صحيح(أ - ب);
    
    اطبع("الضرب 20*7: ");
    اطبع_صحيح(أ * ب);
    
    اطبع("القسمة 20/7: ");
    اطبع_صحيح(أ / ب);
    
    اطبع("باقي القسمة 20%7: ");
    اطبع_صحيح(أ % ب);
    
    // --- العمليات على الأعداد العشرية ---
    اطبع("=== العمليات العشرية ===");
    دع س = 10.5;
    دع ص = 3.2;
    
    اطبع("جمع عشري: ");
    اطبع_عشري(س + ص);
    
    اطبع("ضرب عشري: ");
    اطبع_عشري(س * ص);
    
    // --- العمليات المنطقية ---
    اطبع("=== العمليات المنطقية ===");
    دع ع1 = صح;
    دع ع2 = خطأ;
    
    اطبع("و المنطقية (صح و خطأ): ");
    اطبع_منطقي(ع1 و ع2);
    
    اطبع("أو المنطقية (صح أو خطأ): ");
    اطبع_منطقي(ع1 أو ع2);
    
    اطبع("نفي صح: ");
    اطبع_منطقي(!ع1);
    
    // --- عمليات المقارنة ---
    اطبع("=== عمليات المقارنة ===");
    اطبع("أ > ب: ");
    اطبع_منطقي(أ > ب);
    
    اطبع("أ < ب: ");
    اطبع_منطقي(أ < ب);
    
    اطبع("أ == ب: ");
    اطبع_منطقي(أ == ب);
    
    اطبع("أ != ب: ");
    اطبع_منطقي(أ != ب);
    
    اطبع("أ >= 20: ");
    اطبع_منطقي(أ >= 20);
    
    اطبع("ب <= 7: ");
    اطبع_منطقي(ب <= 7);
    
    اطبع("=== انتهى مثال العمليات ===");
}
