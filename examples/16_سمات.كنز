// =============================================
// مثال 16: السمات (Traits)
// =============================================
// السمات تُشبه الواجهات في لغات أخرى، تُحدد سلوكاً مشتركاً

// === سمة للحساب ===
سمة قابل_للحساب {
    دالة قيمة(&ذاتي) -> ص64;
}

// === هيكل نقطة ===
هيكل نقطة {
    س: ص64,
    ص: ص64,
}

// تنفيذ السمة للنقطة
نفذ قابل_للحساب لـ نقطة {
    دالة قيمة(&ذاتي) -> ص64 {
        أرجع ذاتي.س + ذاتي.ص;
    }
}

// === هيكل عداد ===
هيكل عداد {
    قيمة: ص64,
}

نفذ قابل_للحساب لـ عداد {
    دالة قيمة(&ذاتي) -> ص64 {
        أرجع ذاتي.قيمة * 2;
    }
}

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== السمات ===");
    
    // إنشاء الكائنات
    دع نق = نقطة { س: 10, ص: 20 };
    دع عد = عداد { قيمة: 50 };
    
    // استدعاء دوال السمة
    اطبع("=== قيم الكائنات ===");
    
    اطبع("مجموع النقطة (10+20): ");
    اطبع_صحيح(نق.قيمة());
    
    اطبع("ضعف العداد (50*2): ");
    اطبع_صحيح(عد.قيمة());
    
    // حساب مجموع القيم
    دع مجموع = نق.قيمة() + عد.قيمة();
    اطبع("=== مجموع كل القيم (30+100): ===");
    اطبع_صحيح(مجموع);
    
    اطبع("=== انتهى مثال السمات ===");
    
    أرجع 0;
}
