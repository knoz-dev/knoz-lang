// =============================================
// مثال 7: التعدادات (Enums)
// =============================================

// تعداد بسيط
تعداد اللون {
    أحمر,
    أخضر,
    أزرق
}

// تعداد الحالة
تعداد الحالة {
    نشط,
    معلق,
    منتهي
}

// دالة لعرض اللون
دالة اعرض_لون(ل: اللون) {
    طابق ل {
        اللون::أحمر => {
            اطبع("اللون أحمر");
        }
        اللون::أخضر => {
            اطبع("اللون أخضر");
        }
        اللون::أزرق => {
            اطبع("اللون أزرق");
        }
    }
}

// دالة لفحص الحالة (تطبع مباشرة بدلاً من الإرجاع)
دالة اعرض_حالة(ح: الحالة) {
    طابق ح {
        الحالة::نشط => {
            اطبع("العنصر نشط");
        }
        الحالة::معلق => {
            اطبع("العنصر معلق");
        }
        الحالة::منتهي => {
            اطبع("العنصر منتهي");
        }
    }
}

// الدالة الرئيسية
دالة رئيسية() {
    اطبع("=== التعدادات ===");
    
    // استخدام تعداد اللون
    دع لوني = اللون::أخضر;
    اعرض_لون(لوني);
    
    دع لون2 = اللون::أحمر;
    اعرض_لون(لون2);
    
    دع لون3 = اللون::أزرق;
    اعرض_لون(لون3);
    
    // استخدام تعداد الحالة
    اطبع("=== الحالات ===");
    دع حالة1 = الحالة::نشط;
    اعرض_حالة(حالة1);
    
    دع حالة2 = الحالة::معلق;
    اعرض_حالة(حالة2);
    
    دع حالة3 = الحالة::منتهي;
    اعرض_حالة(حالة3);
    
    اطبع("=== انتهى مثال التعدادات ===");
}
