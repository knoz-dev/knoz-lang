// =============================================
// مثال 8: المطابقة (Pattern Matching)
// =============================================

// دالة لوصف العدد (تطبع مباشرة)
دالة صف_العدد(ع: صحيح) {
    طابق ع {
        0 => {
            اطبع("صفر");
        }
        1 => {
            اطبع("واحد");
        }
        2 => {
            اطبع("اثنان");
        }
        3 => {
            اطبع("ثلاثة");
        }
        _ => {
            اطبع("عدد كبير");
        }
    }
}

// دالة لفحص النطاق (تطبع مباشرة)
دالة اطبع_فئة_العمر(عمر: صحيح) {
    إذا عمر < 0 {
        اطبع("عمر غير صالح");
    } وإلا إذا عمر < 13 {
        اطبع("طفل");
    } وإلا إذا عمر < 20 {
        اطبع("مراهق");
    } وإلا إذا عمر < 60 {
        اطبع("بالغ");
    } وإلا {
        اطبع("كبير السن");
    }
}

// الدالة الرئيسية
دالة رئيسية() {
    اطبع("=== المطابقة ===");
    
    // مطابقة الأرقام
    لكل ي في 0..6 {
        اطبع("العدد: ");
        اطبع_صحيح(ي);
        اطبع(" -> ");
        صف_العدد(ي);
    }
    
    // مطابقة الفئات العمرية
    اطبع("=== فئات الأعمار ===");
    
    اطبع("العمر 5: ");
    اطبع_فئة_العمر(5);
    
    اطبع("العمر 15: ");
    اطبع_فئة_العمر(15);
    
    اطبع("العمر 25: ");
    اطبع_فئة_العمر(25);
    
    اطبع("العمر 65: ");
    اطبع_فئة_العمر(65);
    
    // مطابقة منطقية
    اطبع("=== المطابقة المنطقية ===");
    دع قيمة = صح;
    
    طابق قيمة {
        صح => {
            اطبع("القيمة صحيحة");
        }
        خطأ => {
            اطبع("القيمة خاطئة");
        }
    }
    
    اطبع("=== انتهى مثال المطابقة ===");
}
