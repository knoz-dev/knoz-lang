// =============================================
// مثال 24: الأنواع العامة (Generics)
// Generic Types
// =============================================

// --- هيكل عام بسيط ---
هيكل صندوق<T> {
    قيمة: صحيح,  // نستخدم صحيح مؤقتاً لأن الأنواع العامة تجريبية
}

// --- هيكل مع معاملات ثابتة ---
هيكل مصفوفة_ثابتة<ثابت ن: صحيح> {
    الطول: صحيح,
}

// --- هيكل مع تباين (Variance) ---
// +T يعني تغاير (covariant)
هيكل قارئ<+T> {
    موقع: صحيح,
}

// -T يعني تغاير عكسي (contravariant)
هيكل كاتب<-T> {
    موقع: صحيح,
}

// --- هيكل مع أنواع متداخلة ---
هيكل غلاف<T> {
    موجود: منطقي,
}

// صندوق من غلاف - يختبر الأنواع المتداخلة
هيكل صندوق_غلاف<T> {
    رقم_النوع: صحيح,
}

// --- هيكل عقدة لقائمة ---
هيكل عقدة {
    قيمة: صحيح,
    التالي: صحيح,  // مؤشر للعقدة التالية (0 = نهاية)
}

// دالة لإنشاء عقدة
دالة أنشئ_عقدة(ق: صحيح) -> عقدة {
    أرجع عقدة {
        قيمة: ق,
        التالي: 0,
    };
}

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== الأنواع العامة (Generics) ===");
    
    // --- اختبار الأنواع العامة البسيطة ---
    اطبع("--- الأنواع العامة البسيطة ---");
    اطبع("تم تعريف صندوق<T>");
    
    // --- اختبار المعاملات الثابتة ---
    اطبع("--- المعاملات الثابتة (Const Generics) ---");
    اطبع("تم تعريف مصفوفة_ثابتة<ثابت ن: صحيح>");
    
    // --- اختبار التباين ---
    اطبع("--- التباين (Variance) ---");
    اطبع("تم تعريف قارئ<+T> (covariant)");
    اطبع("تم تعريف كاتب<-T> (contravariant)");
    
    // --- اختبار الأنواع المتداخلة ---
    اطبع("--- الأنواع المتداخلة ---");
    اطبع("تم تعريف صندوق_غلاف<T>");
    
    // --- إنشاء قائمة مرتبطة ---
    اطبع("--- قائمة مرتبطة ---");
    
    دع عقدة1 = أنشئ_عقدة(10);
    دع عقدة2 = أنشئ_عقدة(20);
    دع عقدة3 = أنشئ_عقدة(30);
    
    اطبع("تم إنشاء 3 عقد:");
    اطبع("العقدة 1: ");
    اطبع_صحيح(عقدة1.قيمة);
    اطبع("العقدة 2: ");
    اطبع_صحيح(عقدة2.قيمة);
    اطبع("العقدة 3: ");
    اطبع_صحيح(عقدة3.قيمة);
    
    // --- استخدام اختياري مع الأنواع ---
    اطبع("--- اختياري<صحيح> ---");
    
    دع قيمة_موجودة: اختياري<ص64> = بعض(42);
    دع قيمة_فارغة: اختياري<ص64> = عدم;
    
    إذا قيمة_موجودة.يوجد() {
        اطبع("القيمة موجودة: ");
        اطبع_صحيح(قيمة_موجودة.افتح_أو(0));
    }
    
    إذا !قيمة_فارغة.يوجد() {
        اطبع("القيمة الثانية فارغة");
    }
    
    // --- استخدام قناة مع الأنواع ---
    اطبع("--- قناة<صحيح> ---");
    
    متغير ق = قناة<صحيح>(2);
    أرسل(ق, 100);
    أرسل(ق, 200);
    
    دع ن1 = استقبل(ق);
    دع ن2 = استقبل(ق);
    
    اطبع("استقبلنا من القناة: ");
    اطبع_صحيح(ن1);
    اطبع_صحيح(ن2);
    
    أغلق(ق);
    
    اطبع("=== انتهى مثال الأنواع العامة ===");
    أرجع 0;
}
