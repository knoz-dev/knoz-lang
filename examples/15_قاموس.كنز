// =============================================
// مثال 14: القاموس (HashMap)
// =============================================

دالة رئيسية() -> صحيح {
    اطبع("=== القاموس ===");
    
    // إنشاء قاموس جديد
    دع قاموسي = قاموس_جديد(8, 8);
    اطبع("تم إنشاء القاموس");
    
    // إضافة عناصر
    دع مفتاح1 = 1;
    دع مفتاح2 = 2;
    دع مفتاح3 = 3;
    
    دع قيمة1 = 100;
    دع قيمة2 = 200;
    دع قيمة3 = 300;
    
    قاموس_عين(قاموسي, &مفتاح1, &قيمة1, 8, 8);
    قاموس_عين(قاموسي, &مفتاح2, &قيمة2, 8, 8);
    قاموس_عين(قاموسي, &مفتاح3, &قيمة3, 8, 8);
    
    اطبع("تم إضافة 3 عناصر");
    
    // التحقق من الحجم
    دع حجم = قاموس_طول(قاموسي);
    اطبع("حجم القاموس: ");
    اطبع_صحيح(حجم);
    
    // التحقق من وجود مفتاح
    دع موجود = قاموس_يحتوي(قاموسي, &مفتاح1, 8);
    إذا موجود {
        اطبع("المفتاح 1 موجود");
    }
    
    دع مفتاح_غير_موجود = 99;
    دع غير_موجود = قاموس_يحتوي(قاموسي, &مفتاح_غير_موجود, 8);
    إذا !غير_موجود {
        اطبع("المفتاح 99 غير موجود");
    }
    
    // تحرير الذاكرة
    قاموس_حرر(قاموسي);
    اطبع("تم تحرير القاموس");
    
    اطبع("=== انتهى مثال القاموس ===");
    
    أرجع 0;
}
