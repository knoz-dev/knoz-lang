// =============================================
// مثال 18: النوع الاختياري (Optional Type)
// =============================================
// النوع الاختياري يُستخدم للقيم التي قد تكون موجودة أو غير موجودة
// بعض(قيمة) = يوجد قيمة
// عدم = لا توجد قيمة

// دالة قسمة آمنة
دالة اقسم(أ: ص64, ب: ص64) -> اختياري<ص64> {
    إذا ب == 0 {
        أرجع عدم;
    }
    أرجع بعض(أ / ب);
}

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== النوع الاختياري ===");
    
    // === القسمة الآمنة مع افتح_أو ===
    اطبع("=== القسمة الآمنة ===");
    
    دع ن1 = اقسم(10, 2);
    دع نتيجة1 = ن1.افتح_أو(0);
    اطبع("10 / 2 = ");
    اطبع_صحيح(نتيجة1);
    
    دع ن2 = اقسم(100, 5);
    دع نتيجة2 = ن2.افتح_أو(0);
    اطبع("100 / 5 = ");
    اطبع_صحيح(نتيجة2);
    
    // === القسمة على صفر ===
    اطبع("=== القسمة على صفر ===");
    
    دع ن3 = اقسم(10, 0);
    دع نتيجة3 = ن3.افتح_أو(999);
    اطبع("10 / 0 (أو 999): ");
    اطبع_صحيح(نتيجة3);
    
    // === التحقق من وجود القيمة ===
    اطبع("=== التحقق من الوجود ===");
    
    دع اخ1 = اقسم(100, 5);
    إذا اخ1.يوجد() {
        اطبع("القسمة 100/5 نجحت!");
    } وإلا {
        اطبع("القسمة فشلت!");
    }
    
    دع اخ2 = اقسم(50, 0);
    إذا اخ2.يوجد() {
        اطبع("القسمة نجحت!");
    } وإلا {
        اطبع("القسمة 50/0 فشلت (كما متوقع)!");
    }
    
    // === قيم متعددة ===
    اطبع("=== حسابات متعددة ===");
    
    دع متغير مجموع: ص64 = 0;
    مجموع = مجموع + اقسم(20, 2).افتح_أو(0);  // 10
    مجموع = مجموع + اقسم(30, 3).افتح_أو(0);  // 10
    مجموع = مجموع + اقسم(40, 4).افتح_أو(0);  // 10
    مجموع = مجموع + اقسم(50, 0).افتح_أو(0);  // 0 (فشل)
    
    اطبع("مجموع النتائج (10+10+10+0): ");
    اطبع_صحيح(مجموع);
    
    اطبع("=== انتهى مثال الاختياري ===");
    
    أرجع 0;
}
