// مثال 25: إطلاق الخيوط (Spawn/Threading)
// =============================================

// دالة ستنفذ في خيط منفصل
دالة مهمة_فرعية() {
    اطبع("الخيط الفرعي: بدأ التنفيذ");
    
    // محاكاة عمل
    لكل ي في 1..4 {
        اطبع("الخيط الفرعي: العمل رقم ");
        اطبع_صحيح(ي);
    }
    
    اطبع("الخيط الفرعي: انتهى التنفيذ");
}

// دالة أخرى للخيوط
دالة حساب_مجموع() {
    دع متغير مجموع = 0;
    لكل ي في 1..11 {
        مجموع = مجموع + ي;
    }
    اطبع("خيط الحساب: المجموع من 1 إلى 10 = ");
    اطبع_صحيح(مجموع);
}

// دالة ثالثة
دالة طباعة_أرقام() {
    اطبع("خيط الأرقام: ");
    لكل ي في 1..6 {
        اطبع_صحيح(ي);
    }
}

// دالة للخيط 1
دالة عمل_خيط1() {
    اطبع("خيط 1: يعمل");
}

// دالة للخيط 2
دالة عمل_خيط2() {
    اطبع("خيط 2: يعمل");
}

// دالة للخيط 3
دالة عمل_خيط3() {
    اطبع("خيط 3: يعمل");
}

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== إطلاق الخيوط ===");
    
    // --- إطلاق خيط بدالة ---
    اطبع("--- إطلاق خيط بدالة ---");
    
    اطبع("الخيط الرئيسي: إطلاق خيط فرعي...");
    دع مقبض1 = أطلق(مهمة_فرعية());
    
    اطبع("الخيط الرئيسي: يتابع عمله...");
    اطبع("الخيط الرئيسي: في انتظار الخيط الفرعي...");
    
    // انتظار انتهاء الخيط
    انضم(مقبض1);
    
    اطبع("الخيط الرئيسي: الخيط الفرعي انتهى!");
    
    // --- إطلاق خيط بكتلة مباشرة ---
    اطبع("--- إطلاق خيط بكتلة ---");
    
    دع مقبض2 = أطلق {
        اطبع("خيط الكتلة: مرحباً!");
        اطبع("خيط الكتلة: أنا خيط منفصل");
        اطبع("خيط الكتلة: وداعاً!");
    };
    
    انضم(مقبض2);
    اطبع("الخيط الرئيسي: خيط الكتلة انتهى!");
    
    // --- إطلاق عدة خيوط ---
    اطبع("--- إطلاق عدة خيوط ---");
    
    دع خيط_حساب = أطلق(حساب_مجموع());
    دع خيط_أرقام = أطلق(طباعة_أرقام());
    
    // انتظار جميع الخيوط
    انضم(خيط_حساب);
    انضم(خيط_أرقام);
    
    اطبع("الخيط الرئيسي: جميع الخيوط انتهت!");
    
    // --- إطلاق خيوط متعددة بدوال ---
    اطبع("--- إطلاق خيوط متعددة ---");
    
    دع خ1 = أطلق(عمل_خيط1());
    دع خ2 = أطلق(عمل_خيط2());
    دع خ3 = أطلق(عمل_خيط3());
    
    انضم(خ1);
    انضم(خ2);
    انضم(خ3);
    
    اطبع("الخيط الرئيسي: جميع الخيوط اكتملت!");
    
    اطبع("=== انتهى مثال الخيوط ===");
    أرجع 0;
}
