// =============================================
// مثال 5: المتجهات والمجموعات
// =============================================

دالة رئيسية() {
    اطبع("=== المتجهات ===");
    
    // --- إنشاء متجه ---
    دع م = متجه_جديد(8);
    
    // إضافة عناصر
    دع ق1 = 10;
    دع ق2 = 20;
    دع ق3 = 30;
    دع ق4 = 40;
    دع ق5 = 50;
    
    متجه_أضف(م, &ق1, 8);
    متجه_أضف(م, &ق2, 8);
    متجه_أضف(م, &ق3, 8);
    متجه_أضف(م, &ق4, 8);
    متجه_أضف(م, &ق5, 8);
    
    اطبع("تم إضافة 5 عناصر: 10, 20, 30, 40, 50");
    
    // التحقق من الطول
    دع الطول = متجه_طول(م);
    اطبع("عدد العناصر: ");
    اطبع_صحيح(الطول);
    
    // حساب المجموع
    دع المجموع = متجه_مجموع(م);
    اطبع("المجموع: ");
    اطبع_صحيح(المجموع);
    
    // الحد الأدنى
    دع الادنى = متجه_الحد_الأدنى(م);
    اطبع("الحد الأدنى: ");
    اطبع_صحيح(الادنى);
    
    // الحد الأقصى
    دع الاقصى = متجه_الحد_الأقصى(م);
    اطبع("الحد الأقصى: ");
    اطبع_صحيح(الاقصى);
    
    // المتوسط
    دع المتوسط = متجه_متوسط(م);
    اطبع("المتوسط: ");
    اطبع_عشري(المتوسط);
    
    // التحقق من وجود قيمة
    دع يحتوي = متجه_يحتوي(م, 20);
    إذا يحتوي {
        اطبع("المتجه يحتوي على 20");
    }
    
    // فهرس القيمة
    دع فهرس = متجه_مؤشر(م, 30);
    اطبع("فهرس القيمة 30: ");
    اطبع_صحيح(فهرس);
    
    // حاصل الضرب
    دع الحاصل = متجه_حاصل(م);
    اطبع("حاصل الضرب: ");
    اطبع_صحيح(الحاصل);
    
    // تحرير الذاكرة
    متجه_حرر(م);
    اطبع("تم تحرير المتجه");
    
    اطبع("=== انتهى مثال المتجهات ===");
}
