// الدالة الرئيسية
دالة رئيسية() {
    اطبع("=== عمليات النصوص ===");
    
    // --- النصوص الثابتة ---
    اطبع("--- النصوص الثابتة ---");
    
    اطبع("مرحبا");
    اطبع("بالعالم");
    
    // --- نصوص متعددة ---
    اطبع("--- نصوص متعددة ---");
    
    اطبع("السطر الأول");
    اطبع("السطر الثاني");
    اطبع("السطر الثالث");
    
    // --- النصوص العربية ---
    اطبع("--- النصوص العربية ---");
    
    اطبع("أهلاً وسهلاً بكم في لغة كنز");
    اطبع("الأرقام العربية: ١٢٣٤٥");
    اطبع("الحروف: أ ب ت ث ج ح خ");
    
    // --- استخدام النصوص في الحلقات ---
    اطبع("--- النصوص في الحلقات ---");
    
    لكل ي في 1..4 {
        اطبع("التكرار رقم:");
        اطبع_صحيح(ي);
    }
    
    // --- نصوص طويلة ---
    اطبع("--- نصوص طويلة ---");
    
    اطبع("لغة كنوز هي لغة برمجة عربية مفتوحة المصدر");
    اطبع("تهدف إلى تسهيل تعلم البرمجة للناطقين بالعربية");
    
    اطبع("=== انتهى مثال النصوص ===");
}
