// مثال 9: أنواع النتيجة والاختياري
// =============================================

// دالة تُرجع نتيجة
دالة قسمة(أ: صحيح, ب: صحيح) -> نتيجة<صحيح, نص> {
    إذا ب == 0 {
        أرجع فشل("لا يمكن القسمة على صفر");
    }
    أرجع موافق(أ / ب);
}

// دالة للتحقق من العمر
دالة تحقق_عمر(عمر: صحيح) -> نتيجة<نص, نص> {
    إذا عمر < 0 {
        أرجع فشل("العمر لا يمكن أن يكون سالباً");
    } وإلا إذا عمر > 150 {
        أرجع فشل("العمر غير واقعي");
    }
    أرجع موافق("العمر صالح");
}

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== نوع النتيجة ===");
    
    // قسمة ناجحة
    دع ن1 = قسمة(20, 4);
    اطبع("20 / 4 = ");
    طباعة("{}", ن1);
    
    // قسمة فاشلة
    دع ن2 = قسمة(10, 0);
    اطبع("10 / 0 = ");
    طباعة("{}", ن2);
    
    // التحقق من العمر
    اطبع("=== التحقق من العمر ===");
    
    دع ت1 = تحقق_عمر(25);
    اطبع("عمر 25: ");
    طباعة("{}", ت1);
    
    دع ت2 = تحقق_عمر(-5);
    اطبع("عمر -5: ");
    طباعة("{}", ت2);
    
    دع ت3 = تحقق_عمر(200);
    اطبع("عمر 200: ");
    طباعة("{}", ت3);
    
    اطبع("=== انتهى مثال النتيجة ===");
    
    أرجع 0;
}
