// =============================================
// مثال 11: الأشكال الهندسية
// =============================================

// تعريف هيكل المستطيل
هيكل شكل_مستطيل {
    عرض: عشري,
    ارتفاع: عشري
}

// تعريف هيكل الدائرة
هيكل شكل_دائرة {
    نصف_قطر: عشري
}

// تعريف هيكل المثلث
هيكل شكل_مثلث {
    قاعدة: عشري,
    ارتفاع: عشري
}

// دوال المستطيل
دالة مساحة_مستطيل(م: &شكل_مستطيل) -> عشري {
    أرجع م.عرض * م.ارتفاع;
}

دالة محيط_مستطيل(م: &شكل_مستطيل) -> عشري {
    أرجع 2.0 * (م.عرض + م.ارتفاع);
}

دالة وصف_مستطيل(م: &شكل_مستطيل) {
    اطبع("مستطيل - عرض: ");
    اطبع_عشري(م.عرض);
    اطبع("ارتفاع: ");
    اطبع_عشري(م.ارتفاع);
}

// دوال الدائرة
دالة مساحة_دائرة(د: &شكل_دائرة) -> عشري {
    أرجع 3.14159 * د.نصف_قطر * د.نصف_قطر;
}

دالة محيط_دائرة(د: &شكل_دائرة) -> عشري {
    أرجع 2.0 * 3.14159 * د.نصف_قطر;
}

دالة وصف_دائرة(د: &شكل_دائرة) {
    اطبع("دائرة - نصف القطر: ");
    اطبع_عشري(د.نصف_قطر);
}

// دوال المثلث
دالة مساحة_مثلث(ث: &شكل_مثلث) -> عشري {
    أرجع 0.5 * ث.قاعدة * ث.ارتفاع;
}

دالة وصف_مثلث(ث: &شكل_مثلث) {
    اطبع("مثلث - قاعدة: ");
    اطبع_عشري(ث.قاعدة);
    اطبع("ارتفاع: ");
    اطبع_عشري(ث.ارتفاع);
}

// الدالة الرئيسية
دالة رئيسية() {
    اطبع("=== الأشكال الهندسية ===");
    
    // إنشاء مستطيل
    دع مست = شكل_مستطيل {
        عرض: 10.0,
        ارتفاع: 5.0
    };
    
    وصف_مستطيل(&مست);
    اطبع("المساحة: ");
    اطبع_عشري(مساحة_مستطيل(&مست));
    اطبع("المحيط: ");
    اطبع_عشري(محيط_مستطيل(&مست));
    
    اطبع("");
    
    // إنشاء دائرة
    دع دائ = شكل_دائرة {
        نصف_قطر: 7.0
    };
    
    وصف_دائرة(&دائ);
    اطبع("المساحة: ");
    اطبع_عشري(مساحة_دائرة(&دائ));
    اطبع("المحيط: ");
    اطبع_عشري(محيط_دائرة(&دائ));
    
    اطبع("");
    
    // إنشاء مثلث
    دع مثل = شكل_مثلث {
        قاعدة: 8.0,
        ارتفاع: 6.0
    };
    
    وصف_مثلث(&مثل);
    اطبع("المساحة: ");
    اطبع_عشري(مساحة_مثلث(&مثل));
    
    اطبع("=== انتهى مثال الأشكال ===");
}
