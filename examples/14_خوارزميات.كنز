// دالة المضروب
دالة مضروب(ن: صحيح) -> صحيح {
    إذا ن <= 1 {
        أرجع 1;
    }
    أرجع ن * مضروب(ن - 1);
}

// دالة فيبوناتشي
دالة فيبوناتشي(ن: صحيح) -> صحيح {
    إذا ن <= 1 {
        أرجع ن;
    }
    أرجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2);
}

// دالة القوة
دالة القوة(قاعدة: صحيح, أس: صحيح) -> صحيح {
    إذا أس == 0 {
        أرجع 1;
    }
    دع متغير ناتج = 1;
    دع متغير ع = 0;
    طالما ع < أس {
        ناتج = ناتج * قاعدة;
        ع = ع + 1;
    }
    أرجع ناتج;
}

// دالة فحص العدد الأولي
دالة أولي(ن: صحيح) -> صحيح {
    إذا ن <= 1 {
        أرجع 0;
    }
    إذا ن <= 3 {
        أرجع 1;
    }
    إذا ن % 2 == 0 {
        أرجع 0;
    }
    دع متغير ق = 3;
    طالما ق * ق <= ن {
        إذا ن % ق == 0 {
            أرجع 0;
        }
        ق = ق + 2;
    }
    أرجع 1;
}

// القاسم المشترك الأعظم
دالة ق_م_أ(أ: صحيح, ب: صحيح) -> صحيح {
    إذا ب == 0 {
        أرجع أ;
    }
    أرجع ق_م_أ(ب, أ % ب);
}

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== الخوارزميات والرياضيات ===");
    
    // اختبار المضروب
    اطبع("=== المضروب ===");
    لكل ي في 1..8 {
        اطبع("!");
        اطبع_صحيح(ي);
        اطبع(" = ");
        اطبع_صحيح(مضروب(ي));
    }
    
    // اختبار فيبوناتشي
    اطبع("=== فيبوناتشي ===");
    لكل ن في 0..12 {
        اطبع("فيب(");
        اطبع_صحيح(ن);
        اطبع(") = ");
        اطبع_صحيح(فيبوناتشي(ن));
    }
    
    // اختبار القوة
    اطبع("=== القوة ===");
    اطبع("2^10 = ");
    اطبع_صحيح(القوة(2, 10));
    
    اطبع("3^5 = ");
    اطبع_صحيح(القوة(3, 5));
    
    // اختبار الأعداد الأولية
    اطبع("=== الأعداد الأولية من 1 إلى 20 ===");
    لكل ع في 1..21 {
        إذا أولي(ع) == 1 {
            اطبع_صحيح(ع);
        }
    }
    
    // اختبار القاسم المشترك الأعظم
    اطبع("=== القاسم المشترك الأعظم ===");
    اطبع("ق.م.أ(48, 18) = ");
    اطبع_صحيح(ق_م_أ(48, 18));
    
    اطبع("ق.م.أ(100, 35) = ");
    اطبع_صحيح(ق_م_أ(100, 35));
    
    // حساب مجموع 1 إلى 100
    اطبع("=== المجموع ===");
    دع متغير مجموع = 0;
    دع متغير ع = 1;
    طالما ع <= 100 {
        مجموع = مجموع + ع;
        ع = ع + 1;
    }
    اطبع("مجموع 1 إلى 100 = ");
    اطبع_صحيح(مجموع);
    
    اطبع("=== انتهى مثال الخوارزميات ===");
    
    أرجع 0;
}
