// مثال 26: الشبكات (Networking)
// =============================================

// ثوابت أنواع المقابس
دع TCP: صحيح = 1;
دع UDP: صحيح = 2;

// دالة عميل TCP بسيط
دالة مثال_مقبس() {
    اطبع("=== مثال المقابس ===");
    
    // إنشاء مقبس TCP
    دع مقبس = مقبس_جديد(TCP);
    
    إذا مقبس < 0 {
        اطبع("خطأ: فشل إنشاء المقبس");
        أرجع;
    }
    
    اطبع("تم إنشاء المقبس بنجاح");
    اطبع("رقم المقبس: ");
    اطبع_صحيح(مقبس);
    
    // إغلاق المقبس
    مقبس_أغلق(مقبس);
    اطبع("تم إغلاق المقبس");
}

// دالة لإنشاء مقبسين
دالة مثال_مقابس_متعددة() {
    اطبع("=== مقابس متعددة ===");
    
    // إنشاء مقبس TCP
    دع مقبس1 = مقبس_جديد(TCP);
    اطبع("مقبس TCP رقم: ");
    اطبع_صحيح(مقبس1);
    
    // إنشاء مقبس UDP
    دع مقبس2 = مقبس_جديد(UDP);
    اطبع("مقبس UDP رقم: ");
    اطبع_صحيح(مقبس2);
    
    // إغلاق المقابس
    مقبس_أغلق(مقبس1);
    مقبس_أغلق(مقبس2);
    اطبع("تم إغلاق المقابس");
}

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== الشبكات ===");
    
    // اختبار المقابس
    مثال_مقبس();
    
    // اختبار مقابس متعددة
    مثال_مقابس_متعددة();
    
    // --- معلومات عن دوال الشبكات المتاحة ---
    اطبع("=== دوال الشبكات المتاحة ===");
    اطبع("مقبس_جديد(نوع) - إنشاء مقبس جديد (TCP=1, UDP=2)");
    اطبع("مقبس_اتصل(مقبس, عنوان, منفذ) - الاتصال بخادم");
    اطبع("مقبس_اربط(مقبس, منفذ) - ربط المقبس بمنفذ");
    اطبع("مقبس_استمع(مقبس, حد) - الاستماع للاتصالات");
    اطبع("مقبس_قبول(مقبس) - قبول اتصال جديد");
    اطبع("مقبس_أرسل(مقبس, بيانات, طول) - إرسال بيانات");
    اطبع("مقبس_استقبل(مقبس, مخزن, طول) - استقبال بيانات");
    اطبع("مقبس_أغلق(مقبس) - إغلاق المقبس");
    
    اطبع("=== انتهى مثال الشبكات ===");
    أرجع 0;
}
