// =============================================
// مثال 17: المراجع والاستعارة (References & Borrowing)
// =============================================
// المراجع تسمح بالوصول للبيانات بدون نقل الملكية

// دالة تأخذ مرجع ثابت (لا تُعدل القيمة)
دالة اطبع_القيمة(قيمة: &ص64) {
    اطبع("القيمة: ");
    اطبع_صحيح(*قيمة);
}

// دالة تأخذ مرجع متغير (تُعدل القيمة)
دالة زد_القيمة(قيمة: &متغير ص64) {
    *قيمة = *قيمة + 1;
}

// هيكل للاختبار
هيكل عداد {
    قيمة: ص64,
}

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== المراجع والاستعارة ===");
    
    // === مراجع ثابتة ===
    اطبع("=== مراجع ثابتة ===");
    
    دع عدد = 42;
    اطبع_القيمة(&عدد);
    
    // يمكن عمل عدة مراجع ثابتة
    دع اشارة1 = &عدد;
    دع اشارة2 = &عدد;
    اطبع("قيمة من المرجع الأول: ");
    اطبع_صحيح(*اشارة1);
    اطبع("قيمة من المرجع الثاني: ");
    اطبع_صحيح(*اشارة2);
    
    // === مراجع متغيرة ===
    اطبع("=== مراجع متغيرة ===");
    
    دع متغير رقم: ص64 = 10;
    اطبع("قبل الزيادة: ");
    اطبع_صحيح(رقم);
    
    زد_القيمة(&متغير رقم);
    اطبع("بعد الزيادة (+1): ");
    اطبع_صحيح(رقم);
    
    // === مراجع للهياكل ===
    اطبع("=== مراجع للهياكل ===");
    
    دع متغير عد = عداد { قيمة: 100 };
    اطبع("قيمة العداد: ");
    اطبع_صحيح(عد.قيمة);
    
    // تعديل القيمة مباشرة
    عد.قيمة = عد.قيمة + 50;
    اطبع("بعد إضافة 50: ");
    اطبع_صحيح(عد.قيمة);
    
    اطبع("=== انتهى مثال المراجع ===");
    
    أرجع 0;
}
