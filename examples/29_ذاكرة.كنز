// مثال 29: إدارة الذاكرة
// Example 29: Memory Management

// دالة لعرض الفاصل
دالة فاصل(عنوان: نص) {
    اطبع("===================");
    اطبع(عنوان);
    اطبع("===================");
}

// الدالة الرئيسية
دالة رئيسية() {
    فاصل("إدارة الذاكرة");
    
    // --- حجز الذاكرة ---
    اطبع("--- حجز الذاكرة ---");
    
    // حجز ذاكرة - احجز تأخذ الحجم بالبايت
    دع حجم: صحيح = 80;  // 10 * 8 bytes
    دع ذاكرة = احجز(حجم);
    
    إذا ذاكرة != 0 {
        اطبع("تم حجز الذاكرة بنجاح");
        اطبع(ذاكرة);  // عرض عنوان الذاكرة
        
        // تحرير الذاكرة
        حرر(ذاكرة);
        اطبع("تم تحرير الذاكرة");
    } وإلا {
        اطبع("فشل حجز الذاكرة");
    }
    
    // --- حجز ذاكرة متعددة ---
    اطبع("--- حجز ذاكرة متعددة ---");
    
    // حجز عدة قطع من الذاكرة
    دع ذاكرة1 = احجز(100);
    دع ذاكرة2 = احجز(200);
    دع ذاكرة3 = احجز(50);
    
    إذا ذاكرة1 != 0 {
        اطبع("تم حجز كتلة 1");
    }
    إذا ذاكرة2 != 0 {
        اطبع("تم حجز كتلة 2");
    }
    إذا ذاكرة3 != 0 {
        اطبع("تم حجز كتلة 3");
    }
    
    // تحرير الذاكرة بالترتيب العكسي
    حرر(ذاكرة3);
    حرر(ذاكرة2);
    حرر(ذاكرة1);
    اطبع("تم تحرير جميع الكتل");
    
    // --- مثال عملي: حجز ذاكرة في حلقة ---
    اطبع("--- حجز ذاكرة في حلقة ---");
    
    متغير عداد: صحيح = 0;
    طالما عداد < 5 {
        دع قطعة = احجز(16);
        إذا قطعة != 0 {
            اطبع("تم حجز قطعة");
            حرر(قطعة);  // تحرير فوري لتجنب تسرب الذاكرة
        }
        عداد = عداد + 1;
    }
    
    اطبع("تم حجز وتحرير 5 قطع بنجاح");
    
    // --- حسابات حجم الذاكرة ---
    اطبع("--- حسابات الحجم ---");
    
    دع عدد_العناصر: صحيح = 100;
    دع حجم_العنصر: صحيح = 8;  // 8 bytes لكل عنصر صحيح
    دع الحجم_الكلي = عدد_العناصر * حجم_العنصر;
    
    اطبع("عدد العناصر:");
    اطبع(عدد_العناصر);
    اطبع("حجم كل عنصر:");
    اطبع(حجم_العنصر);
    اطبع("الحجم الكلي:");
    اطبع(الحجم_الكلي);
    
    دع مصفوفة_ديناميكية = احجز(الحجم_الكلي);
    إذا مصفوفة_ديناميكية != 0 {
        اطبع("تم حجز مصفوفة ديناميكية");
        حرر(مصفوفة_ديناميكية);
        اطبع("تم تحريرها");
    }
    
    فاصل("انتهى المثال");
}
