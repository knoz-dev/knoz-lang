// ===================================================
// مثال 5: المصفوفات - Arrays
// ===================================================
// يغطي: المصفوفات الثابتة، الصفوف، الوصول للعناصر

دالة رئيسية() -> صحيح {
    اطبع("=== مثال المصفوفات ===");
    
    // === 1. مصفوفة أعداد صحيحة ===
    اطبع("--- مصفوفة أعداد صحيحة ---");
    دع أعداد = [10, 20, 30, 40, 50];
    اطبع("تم إنشاء مصفوفة من 5 أعداد");
    
    // الوصول للعنصر الأول (الفهرس 0)
    دع الأول = أعداد[0];
    اطبع("العنصر الأول:");
    اطبع_صحيح(الأول);
    
    // الوصول للعنصر الثالث (الفهرس 2)
    دع الثالث = أعداد[2];
    اطبع("العنصر الثالث:");
    اطبع_صحيح(الثالث);
    
    // === 2. مصفوفة أعداد عشرية ===
    اطبع("--- مصفوفة أعداد عشرية ---");
    دع عشرية = [1.5, 2.7, 3.9, 4.1];
    دع قيمة = عشرية[1];
    اطبع("العنصر الثاني من المصفوفة العشرية:");
    اطبع_عشري(قيمة);
    
    // === 3. الصفوف (Tuples) - عناصر مختلفة الأنواع ===
    اطبع("--- الصفوف ---");
    دع صف = (42, 3.14);
    اطبع("تم إنشاء صف يحتوي على عدد صحيح وعشري");
    
    // الوصول لعناصر الصف
    دع عنصر_أول = صف.0;
    دع عنصر_ثاني = صف.1;
    اطبع("العنصر الأول من الصف:");
    اطبع_صحيح(عنصر_أول);
    اطبع("العنصر الثاني من الصف:");
    اطبع_عشري(عنصر_ثاني);
    
    // === 4. حساب مجموع المصفوفة يدوياً ===
    اطبع("--- حساب مجموع المصفوفة ---");
    دع قيم = [5, 10, 15, 20, 25];
    دع متغير مجموع = 0;
    
    // جمع العناصر
    مجموع = مجموع + قيم[0];
    مجموع = مجموع + قيم[1];
    مجموع = مجموع + قيم[2];
    مجموع = مجموع + قيم[3];
    مجموع = مجموع + قيم[4];
    
    اطبع("المجموع:");
    اطبع_صحيح(مجموع);  // 75
    
    // === 5. صف متعدد العناصر ===
    اطبع("--- صف متعدد العناصر ---");
    دع معلومات = (100, 200, 300);
    اطبع("عناصر الصف:");
    اطبع_صحيح(معلومات.0);
    اطبع_صحيح(معلومات.1);
    اطبع_صحيح(معلومات.2);
    
    اطبع("=== انتهى مثال المصفوفات ===");
    أرجع 0;
}
