// =============================================
// مثال 21: تحويل الأنواع (Type Conversions)
// =============================================
// دوال التحويل بين الأنواع المختلفة

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== تحويل الأنواع ===");
    
    // === من صحيح إلى عشري ===
    اطبع("=== صحيح إلى عشري ===");
    
    دع ر: ص64 = 10;
    دع ع_ر = صحيح_لعشري(ر);
    اطبع("الرقم 10 كعشري:");
    اطبع_عشري(ع_ر);
    
    // === من عشري إلى صحيح ===
    اطبع("=== عشري إلى صحيح ===");
    
    دع ع2: ع64 = 7.9;
    دع ص_ع = عشري_لصحيح(ع2);
    اطبع("الرقم 7.9 كصحيح (تقطيع):");
    اطبع_صحيح(ص_ع);
    
    // === التقريب ===
    اطبع("=== التقريب ===");
    
    دع ع3: ع64 = 7.6;
    دع مقرب = تقريب(ع3);
    اطبع("تقريب 7.6:");
    اطبع_صحيح(مقرب);
    
    دع ع4: ع64 = 7.2;
    دع مقرب2 = تقريب(ع4);
    اطبع("تقريب 7.2:");
    اطبع_صحيح(مقرب2);
    
    // === الأرضية والسقف ===
    اطبع("=== الأرضية والسقف ===");
    
    دع ع5: ع64 = 5.7;
    اطبع("أرضية 5.7:");
    اطبع_صحيح(أرضية(ع5));
    
    اطبع("سقف 5.7:");
    اطبع_صحيح(سقف(ع5));
    
    // === من منطقي إلى نص ===
    اطبع("=== منطقي إلى نص ===");
    
    دع ص1: منطقي = صح;
    اطبع("صح كنص:");
    اطبع(منطقي_لنص(ص1));
    
    دع ص2: منطقي = خطأ;
    اطبع("خطأ كنص:");
    اطبع(منطقي_لنص(ص2));
    
    // === حسابات مع التحويل ===
    اطبع("=== حسابات مع التحويل ===");
    
    دع أ: ص64 = 5;
    دع ب: ص64 = 2;
    دع ناتج = صحيح_لعشري(أ) / صحيح_لعشري(ب);
    اطبع("5 / 2 كعشري:");
    اطبع_عشري(ناتج);
    
    اطبع("=== انتهى مثال تحويل الأنواع ===");
    
    أرجع 0;
}
