// =============================================
// مثال 3: عبارات التحكم في التدفق
// =============================================

دالة رئيسية() {
    اطبع("=== عبارات التحكم ===");
    
    // --- إذا وإلا ---
    دع عمر = 25;
    
    إذا عمر >= 18 {
        اطبع("بالغ");
    } وإلا {
        اطبع("قاصر");
    }
    
    // --- إذا متعددة ---
    دع درجة = 85;
    
    إذا درجة >= 90 {
        اطبع("ممتاز");
    } وإلا إذا درجة >= 80 {
        اطبع("جيد جداً");
    } وإلا إذا درجة >= 70 {
        اطبع("جيد");
    } وإلا {
        اطبع("مقبول");
    }
    
    // --- حلقة طالما ---
    اطبع("=== حلقة طالما ===");
    دع متغير ي = 1;
    طالما ي <= 5 {
        اطبع("العدد: ");
        اطبع_صحيح(ي);
        ي = ي + 1;
    }
    
    // --- حلقة لكل مع نطاق ---
    اطبع("=== حلقة لكل ===");
    لكل ن في 1..4 {
        اطبع("تكرار: ");
        اطبع_صحيح(ن);
    }
    
    // --- حلقة كرر مع توقف ---
    اطبع("=== حلقة كرر ===");
    دع متغير عداد = 0;
    كرر {
        عداد = عداد + 1;
        اطبع("كرر رقم: ");
        اطبع_صحيح(عداد);
        إذا عداد >= 3 {
            أوقف;
        }
    }
    
    // --- استمر في الحلقة ---
    اطبع("=== استمر ===");
    لكل م في 1..6 {
        إذا م == 3 {
            تابع;
        }
        اطبع("رقم: ");
        اطبع_صحيح(م);
    }
    
    اطبع("=== انتهى مثال التحكم ===");
}
