// مثال 30: حسابات ديناميكية باستخدام الذاكرة
// Example 30: Dynamic Calculations Using Memory
// ملاحظة: دوال التزامن تسبب مشاكل في الربط والتشغيل
// Note: Concurrency functions cause linker and runtime issues

// دالة لعرض الفاصل
دالة فاصل(عنوان: نص) {
    اطبع("===================");
    اطبع(عنوان);
    اطبع("===================");
}

// حساب فيبوناتشي
دالة فيبوناتشي(ن: صحيح) -> صحيح {
    إذا ن <= 1 {
        أرجع ن;
    }
    أرجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2);
}

// حساب المضروب
دالة مضروب(ن: صحيح) -> صحيح {
    إذا ن <= 1 {
        أرجع 1;
    }
    أرجع ن * مضروب(ن - 1);
}

// حساب القوة
دالة قوة(أساس: صحيح, أس: صحيح) -> صحيح {
    إذا أس == 0 {
        أرجع 1;
    }
    أرجع أساس * قوة(أساس, أس - 1);
}

// الدالة الرئيسية
دالة رئيسية() {
    فاصل("حسابات ديناميكية");
    
    // --- متتالية فيبوناتشي ---
    اطبع("--- متتالية فيبوناتشي ---");
    
    متغير ف: صحيح = 0;
    طالما ف < 12 {
        دع قيمة = فيبوناتشي(ف);
        اطبع(قيمة);
        ف = ف + 1;
    }
    
    // --- المضروب ---
    اطبع("--- المضروب ---");
    
    متغير م: صحيح = 1;
    طالما م <= 7 {
        دع نتيجة_مضروب = مضروب(م);
        اطبع(م);
        اطبع(نتيجة_مضروب);
        م = م + 1;
    }
    
    // --- قوى العدد 2 ---
    اطبع("--- قوى 2 ---");
    
    متغير ق: صحيح = 0;
    طالما ق <= 10 {
        دع نتيجة_قوة = قوة(2, ق);
        اطبع(نتيجة_قوة);
        ق = ق + 1;
    }
    
    // --- مجموع المربعات ---
    اطبع("--- مجموع المربعات ---");
    
    متغير مجموع_مربعات: صحيح = 0;
    متغير ع: صحيح = 1;
    
    طالما ع <= 10 {
        مجموع_مربعات = مجموع_مربعات + (ع * ع);
        ع = ع + 1;
    }
    
    اطبع("مجموع مربعات 1 إلى 10:");
    اطبع(مجموع_مربعات);
    
    // --- مجموع المكعبات ---
    اطبع("--- مجموع المكعبات ---");
    
    متغير مجموع_مكعبات: صحيح = 0;
    متغير ك: صحيح = 1;
    
    طالما ك <= 5 {
        مجموع_مكعبات = مجموع_مكعبات + (ك * ك * ك);
        ك = ك + 1;
    }
    
    اطبع("مجموع مكعبات 1 إلى 5:");
    اطبع(مجموع_مكعبات);
    
    فاصل("انتهى المثال");
}
