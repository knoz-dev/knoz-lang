// =============================================
// مثال 6: الهياكل (Structs)
// =============================================

// تعريف هيكل بسيط
هيكل نقطة {
    س: صحيح,
    ص: صحيح
}

// هيكل مع أنواع مختلفة
هيكل شخص {
    الاسم: نص,
    العمر: صحيح
}

// هيكل مستطيل
هيكل مستطيل {
    العرض: عشري,
    الارتفاع: عشري
}

// دالة لحساب المساحة
دالة احسب_المساحة(م: &مستطيل) -> عشري {
    أرجع م.العرض * م.الارتفاع;
}

// دالة لحساب المحيط
دالة احسب_المحيط(م: &مستطيل) -> عشري {
    أرجع 2.0 * (م.العرض + م.الارتفاع);
}

// دالة لعرض النقطة
دالة اعرض_نقطة(ن: &نقطة) {
    اطبع("نقطة س: ");
    اطبع_صحيح(ن.س);
    اطبع("نقطة ص: ");
    اطبع_صحيح(ن.ص);
}

// الدالة الرئيسية
دالة رئيسية() {
    اطبع("=== الهياكل ===");
    
    // إنشاء نقطة
    دع ن1 = نقطة { س: 10, ص: 20 };
    اطبع("النقطة الأولى:");
    اعرض_نقطة(&ن1);
    
    // إنشاء شخص
    دع موظف = شخص {
        الاسم: "خالد",
        العمر: 35
    };
    
    اطبع("=== معلومات الموظف ===");
    اطبع("الاسم: ");
    اطبع(موظف.الاسم);
    اطبع("العمر: ");
    اطبع_صحيح(موظف.العمر);
    
    // إنشاء مستطيل وحساب المساحة
    دع مست = مستطيل {
        العرض: 10.5,
        الارتفاع: 5.0
    };
    
    اطبع("=== المستطيل ===");
    اطبع("العرض: ");
    اطبع_عشري(مست.العرض);
    اطبع("الارتفاع: ");
    اطبع_عشري(مست.الارتفاع);
    اطبع("المساحة: ");
    اطبع_عشري(احسب_المساحة(&مست));
    اطبع("المحيط: ");
    اطبع_عشري(احسب_المحيط(&مست));
    
    // هيكل متغير
    دع متغير ن2 = نقطة { س: 0, ص: 0 };
    اطبع("النقطة قبل التعديل:");
    اعرض_نقطة(&ن2);
    
    ن2.س = 100;
    ن2.ص = 200;
    اطبع("النقطة بعد التعديل:");
    اعرض_نقطة(&ن2);
    
    اطبع("=== انتهى مثال الهياكل ===");
}
