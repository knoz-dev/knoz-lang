// =============================================
// مثال 4: الدوال والمعاملات
// =============================================

// دالة بسيطة بدون معاملات
دالة تحية() {
    اطبع("مرحباً من الدالة!");
}

// دالة مع معاملات
دالة اجمع(أ: صحيح, ب: صحيح) -> صحيح {
    أرجع أ + ب;
}

// دالة تكرارية - فيبوناتشي
دالة فيب(ن: صحيح) -> صحيح {
    إذا ن <= 1 {
        أرجع ن;
    }
    أرجع فيب(ن - 1) + فيب(ن - 2);
}

// دالة مع قيمة عشرية
دالة احسب_دائرة(نق: عشري) -> عشري {
    أرجع 3.14159 * نق * نق;
}

// الدالة الرئيسية
دالة رئيسية() {
    اطبع("=== الدوال ===");
    
    // استدعاء دالة بسيطة
    تحية();
    
    // استدعاء دالة مع معاملات
    دع ناتج = اجمع(15, 27);
    اطبع("ناتج الجمع 15+27: ");
    اطبع_صحيح(ناتج);
    
    // استدعاء دالة تكرارية
    اطبع("=== فيبوناتشي ===");
    لكل ي في 0..11 {
        اطبع("فيب: ");
        اطبع_صحيح(فيب(ي));
    }
    
    // مساحة دائرة
    دع م = احسب_دائرة(5.0);
    اطبع("مساحة الدائرة (نق=5): ");
    اطبع_عشري(م);
    
    اطبع("=== انتهى مثال الدوال ===");
}
