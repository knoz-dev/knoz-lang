// =============================================
// مثال 22: القنوات (Channels)
// =============================================
// القنوات للتواصل بين الخيوط المتزامنة

// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== القنوات ===");
    
    // === إنشاء قناة ===
    اطبع("=== إنشاء قناة ===");
    
    متغير ق = قناة<صحيح>(3);
    اطبع("تم إنشاء قناة بسعة 3");
    
    // === إرسال قيم ===
    اطبع("=== إرسال قيم ===");
    
    أرسل(ق, 10);
    اطبع("أرسلنا: 10");
    
    أرسل(ق, 20);
    اطبع("أرسلنا: 20");
    
    أرسل(ق, 30);
    اطبع("أرسلنا: 30");
    
    // === التحقق من الحالة ===
    اطبع("=== التحقق من الحالة ===");
    
    إذا قناة_بيانات(ق) {
        اطبع("القناة تحتوي على بيانات");
    }
    
    إذا قناة_فارغة(ق) {
        اطبع("القناة فارغة");
    } وإلا {
        اطبع("القناة ليست فارغة");
    }
    
    // === استقبال قيم ===
    اطبع("=== استقبال قيم ===");
    
    دع ق1 = استقبل(ق);
    اطبع("استقبلنا:");
    اطبع_صحيح(ق1);
    
    دع ق2 = استقبل(ق);
    اطبع("استقبلنا:");
    اطبع_صحيح(ق2);
    
    دع ق3 = استقبل(ق);
    اطبع("استقبلنا:");
    اطبع_صحيح(ق3);
    
    // === بعد الاستقبال ===
    اطبع("=== بعد الاستقبال ===");
    
    إذا قناة_فارغة(ق) {
        اطبع("القناة أصبحت فارغة");
    }
    
    // === إغلاق القناة ===
    اطبع("=== إغلاق القناة ===");
    
    أغلق(ق);
    اطبع("تم إغلاق القناة");
    
    إذا قناة_مغلقة(ق) {
        اطبع("القناة مغلقة الآن");
    }
    
    اطبع("=== انتهى مثال القنوات ===");
    
    أرجع 0;
}
