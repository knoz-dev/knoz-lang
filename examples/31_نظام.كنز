// مثال 31: دوال النظام والوقت
// Example 31: System and Time Functions

// دالة لعرض الفاصل
دالة فاصل(عنوان: نص) {
    اطبع("===================");
    اطبع(عنوان);
    اطبع("===================");
}

// حساب الوقت المستغرق
دالة قياس_وقت_فيبوناتشي(ن: صحيح) -> صحيح {
    إذا ن <= 1 {
        أرجع ن;
    }
    أرجع قياس_وقت_فيبوناتشي(ن - 1) + قياس_وقت_فيبوناتشي(ن - 2);
}

// الدالة الرئيسية
دالة رئيسية() {
    فاصل("دوال النظام");
    
    // --- الوقت الحالي ---
    اطبع("--- الوقت الحالي ---");
    
    دع وقت_البدء = وقت();
    اطبع("وقت البدء (بالثواني من 1970):");
    اطبع(وقت_البدء);
    
    // --- قياس وقت التنفيذ ---
    اطبع("--- قياس وقت التنفيذ ---");
    
    دع بداية = وقت();
    
    // حساب فيبوناتشي لقياس الوقت
    متغير فيب: صحيح = 0;
    متغير أ: صحيح = 0;
    متغير ب: صحيح = 1;
    متغير ع: صحيح = 0;
    
    طالما ع < 40 {
        دع ت = أ + ب;
        أ = ب;
        ب = ت;
        ع = ع + 1;
    }
    
    دع نهاية = وقت();
    دع الفرق = نهاية - بداية;
    
    اطبع("فيبوناتشي 40:");
    اطبع(ب);
    اطبع("الوقت المستغرق (بالثواني):");
    اطبع(الفرق);
    
    // --- حسابات رياضية ---
    اطبع("--- حسابات رياضية ---");
    
    // حساب مجموع الأعداد الفردية
    متغير مجموع_فردي: صحيح = 0;
    متغير ن: صحيح = 1;
    
    طالما ن <= 19 {
        مجموع_فردي = مجموع_فردي + ن;
        ن = ن + 2;
    }
    
    اطبع("مجموع الأعداد الفردية من 1 إلى 19:");
    اطبع(مجموع_فردي);
    
    // حساب مجموع الأعداد الزوجية
    متغير مجموع_زوجي: صحيح = 0;
    متغير م: صحيح = 2;
    
    طالما م <= 20 {
        مجموع_زوجي = مجموع_زوجي + م;
        م = م + 2;
    }
    
    اطبع("مجموع الأعداد الزوجية من 2 إلى 20:");
    اطبع(مجموع_زوجي);
    
    // --- توليد أرقام عشوائية ---
    اطبع("--- أرقام عشوائية ---");
    
    متغير ر: صحيح = 0;
    طالما ر < 5 {
        دع رقم = عشوائي();
        // تحويل لنطاق 1-100
        متغير رقم_محدود: صحيح = (رقم % 100) + 1;
        إذا رقم_محدود < 0 {
            رقم_محدود = رقم_محدود * -1;
        }
        اطبع(رقم_محدود);
        ر = ر + 1;
    }
    
    // --- الوقت النهائي ---
    اطبع("--- الوقت النهائي ---");
    
    دع وقت_النهاية = وقت();
    اطبع("وقت النهاية:");
    اطبع(وقت_النهاية);
    
    دع المدة_الكلية = وقت_النهاية - وقت_البدء;
    اطبع("المدة الكلية للبرنامج:");
    اطبع(المدة_الكلية);
    
    فاصل("انتهى المثال");
}
