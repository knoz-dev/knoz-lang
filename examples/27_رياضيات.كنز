// الدالة الرئيسية
دالة رئيسية() -> صحيح {
    اطبع("=== الدوال الرياضية ===");
    
    // --- الجذر التربيعي ---
    اطبع("--- الجذر التربيعي ---");
    
    دع جذر16 = جذر_تربيعي(16.0);
    اطبع("جذر_تربيعي(16) = ");
    اطبع_عشري(جذر16);
    
    دع جذر25 = جذر_تربيعي(25.0);
    اطبع("جذر_تربيعي(25) = ");
    اطبع_عشري(جذر25);
    
    دع جذر2 = جذر_تربيعي(2.0);
    اطبع("جذر_تربيعي(2) = ");
    اطبع_عشري(جذر2);
    
    // --- الأُس ---
    اطبع("--- الأُس ---");
    
    دع قوة1 = قوة_ع(2.0, 10.0);
    اطبع("2 أُس 10 = ");
    اطبع_عشري(قوة1);
    
    دع قوة2 = قوة_ع(3.0, 4.0);
    اطبع("3 أُس 4 = ");
    اطبع_عشري(قوة2);
    
    دع قوة3 = قوة_ع(10.0, 2.0);
    اطبع("10 أُس 2 = ");
    اطبع_عشري(قوة3);
    
    // --- الدوال المثلثية ---
    اطبع("--- الدوال المثلثية ---");
    
    دع جيب_صفر = جيب(0.0);
    اطبع("جيب(0) = ");
    اطبع_عشري(جيب_صفر);
    
    دع جتا_صفر = جتا(0.0);
    اطبع("جتا(0) = ");
    اطبع_عشري(جتا_صفر);
    
    // جيب 90 درجة (π/2)
    دع نصف_بي = 1.5707963267949;
    دع جيب_90 = جيب(نصف_بي);
    اطبع("جيب(π/2) ≈ ");
    اطبع_عشري(جيب_90);
    
    // --- القيمة المطلقة ---
    اطبع("--- القيمة المطلقة ---");
    
    دع مطلق1 = مطلق_عشري(-42.0);
    اطبع("مطلق_عشري(-42.0) = ");
    اطبع_عشري(مطلق1);
    
    دع مطلق2 = مطلق_عشري(-3.14);
    اطبع("مطلق_عشري(-3.14) = ");
    اطبع_عشري(مطلق2);
    
    دع مطلق3 = مطلق_عشري(100.5);
    اطبع("مطلق_عشري(100.5) = ");
    اطبع_عشري(مطلق3);
    
    // --- الأرقام العشوائية ---
    اطبع("--- الأرقام العشوائية ---");
    
    دع عشوائي1 = عشوائي();
    اطبع("عشوائي() = ");
    اطبع_صحيح(عشوائي1);
    
    دع عشوائي2 = عشوائي();
    اطبع("عشوائي() = ");
    اطبع_صحيح(عشوائي2);
    
    // --- حسابات رياضية مركبة ---
    اطبع("--- حسابات مركبة ---");
    
    // فيثاغورس: c = sqrt(a^2 + b^2)
    دع أ = 3.0;
    دع ب = 4.0;
    دع أ_تربيع = قوة_ع(أ, 2.0);
    دع ب_تربيع = قوة_ع(ب, 2.0);
    دع جـ = جذر_تربيعي(أ_تربيع + ب_تربيع);
    اطبع("وتر المثلث (3,4): ");
    اطبع_عشري(جـ);
    
    // مساحة الدائرة = π * r^2
    دع نق = 5.0;
    دع بي = 3.14159265359;
    دع م_دائرة = بي * قوة_ع(نق, 2.0);
    اطبع("مساحة دائرة (نق=5): ");
    اطبع_عشري(م_دائرة);
    
    اطبع("=== انتهى مثال الرياضيات ===");
    أرجع 0;
}
